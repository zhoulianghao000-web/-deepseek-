# ============ 服务端口与安全 ============
# 后端 HTTP 端口（微信服务器需要能访问到该端口或其反向代理）
PORT=3000

# 管理接口令牌（可选）。设置后 /api/admin/* 必须携带 x-admin-token 请求头，
# 在控制台左下角「管理令牌」中填写同样的值。
# ADMIN_TOKEN=change-me

# 公网访问地址（可选）。用于在控制台展示微信接入 URL。
# 未设置时自动使用请求的 Host。部署到公网时建议显式配置。
# PUBLIC_BASE_URL=https://your-domain.com

# CodeBuddy Agent SDK 的工作目录（可选）
# AGENT_CWD=D:/workspace

# 是否把日志同时输出到控制台（默认 1）
# LOG_TO_CONSOLE=1

# ============ AI 服务凭证（可选，控制台可覆盖） ============
# 方式一：CodeBuddy API Key（使用 CodeBuddy Agent SDK 提供方）
# CODEBUDDY_API_KEY=your_codebuddy_api_key
# CODEBUDDY_AUTH_TOKEN=
# CODEBUDDY_BASE_URL=
# CODEBUDDY_INTERNET_ENVIRONMENT=external

# 方式二：OpenAI 兼容服务（DeepSeek / Moonshot / Ollama / vLLM ...）
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ============ 微信公众号（可选，控制台可覆盖） ============
# 与公众号后台「服务器配置」中的 Token 完全一致，用于签名校验
# WECHAT_TOKEN=your_wechat_token
# WECHAT_APP_ID=wx1234567890abcdef
# WECHAT_APP_SECRET=your_app_secret
